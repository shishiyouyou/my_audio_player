APP_NAME=自建音乐库后台
APP_HOST=0.0.0.0
APP_PORT=8000

# 本地开发可继续使用 SQLite；生产建议改成 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://music_hub:请修改密码@127.0.0.1:5432/music_hub
DATABASE_URL=sqlite:///./data/music_hub.db

REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_NAMESPACE=music_hub
TASK_WORKER_CONCURRENCY=2
METADATA_CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_DOWNLOAD_RATE_LIMIT_PER_MINUTE=12
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改这个后台密码
SESSION_SECRET=请修改为一串随机字符串
LASTFM_API_KEY=请填写你的Last.fm API Key
LASTFM_COUNTRY=China
SYNC_CRON_HOUR=3
SYNC_CRON_MINUTE=10
INBOX_DIR=./data/inbox
MUSIC_DIR=./data/music
NAVIDROME_BASE_URL=http://127.0.0.1:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
